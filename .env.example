# Copy to .env.local and fill in. Git ignores .env.local.
#
# Local development: run `supabase status` and copy API_URL and PUBLISHABLE_KEY.
# Production: Supabase dashboard → Project Settings → API.
#
# Both values are PUBLIC by design (they end up in the browser).
# Security comes from Row Level Security, not from hiding these.
# NEVER put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
